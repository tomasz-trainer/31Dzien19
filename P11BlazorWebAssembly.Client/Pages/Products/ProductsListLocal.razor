@page "/products/productslistlocal"

@inject IProductService ProductService
@inject NavigationManager NavigationManager

<h3>ProductsList</h3>

<p><NavLink href="products/createproduct" class="btn btn-primary">New product</NavLink></p>


@if (products == null)
{
    <p>@message</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th style="cursor: pointer" @onclick='() => SortBy("Id")'>Id @SortIndicator("Id")</th>
                <th style="cursor: pointer" @onclick='() => SortBy("Title")'>Title @SortIndicator("Title")</th>
                <th style="cursor: pointer" @onclick='() => SortBy("Barcode")'>Barcode @SortIndicator("Barcode")</th>
                <th style="cursor: pointer" @onclick='() => SortBy("Price")'>Price @SortIndicator("Price")</th>
                <th style="cursor: pointer" @onclick='() => SortBy("ReleaseDate")'>ReleaseDate @SortIndicator("ReleaseDate")</th>
                <th>Options</th>
            </tr>
        </thead>
        <tbody>
            @if (!PagedProducts.Any())
            {
                <tr><td colspan="6"><em>Brak produktów</em></td></tr>
            }
            @foreach (var product in PagedProducts)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Title</td>
                    <td>@product.Barcode</td>
                    <td>@product.Price</td>
                    <td>@product.ReleaseDate.ToShortDateString()</td>
                    <td><button class="btn btn-primary" @onclick="() => EditProduct(product.Id)">Edit</button></td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-primary" @onclick="PreviousPage" disabled="@(currentPage == 1)">Poprzednia</button>
    <span style="margin: 0 10px">Strona @currentPage z @TotalPages</span>
    <button class="btn btn-primary" @onclick="NextPage" disabled="@(currentPage >= TotalPages)">Następna</button>
}

@code {

    List<Product>? products;
    string message = "Loading products...";

    int currentPage = 1;
    const int pageSize = 10;

    // liczba wszystkich stron, minimum 1, żeby nie pokazywać "Strona 1 z 0" przy pustej liście
    int TotalPages => products == null || products.Count == 0
        ? 1
        : (int)Math.Ceiling(products.Count / (double)pageSize);

    string? sortColumn;
    bool sortDescending;

    IEnumerable<Product> SortedProducts
    {
        get
        {
            if (products == null) return Enumerable.Empty<Product>();

            return sortColumn switch
            {
                "Id" => Order(p => p.Id),
                "Title" => Order(p => p.Title),
                "Barcode" => Order(p => p.Barcode),
                "Price" => Order(p => p.Price),
                "ReleaseDate" => Order(p => p.ReleaseDate),
                _ => products
            };
        }
    }

    IEnumerable<Product> Order<TKey>(Func<Product, TKey> keySelector) =>
        sortDescending ? products!.OrderByDescending(keySelector) : products!.OrderBy(keySelector);

    // wycinek posortowanej listy odpowiadający bieżącej stronie
    IEnumerable<Product> PagedProducts =>
        SortedProducts.Skip((currentPage - 1) * pageSize).Take(pageSize);

    void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
        currentPage = 1;
    }

    string SortIndicator(string column) =>
        sortColumn != column ? string.Empty : sortDescending ? " ▼" : " ▲";

    override protected async Task OnInitializedAsync()
    {
        var response = await ProductService.GetProductsAsync();

        if (response.Success)
        {
            products = response.Data;
        }
        else
        {
            message = "Server error, can't download products data";
        }
    }

    void EditProduct(int productId)
    {
        // Navigate to the edit product page with the product ID
        NavigationManager.NavigateTo($"/products/editproduct/{productId}");
    }

    void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }
}