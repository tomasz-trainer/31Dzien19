@page "/products/productslist"

@inject IProductService ProductService
@inject NavigationManager NavigationManager

<h3>ProductsList</h3>

<p><NavLink href="products/createproduct" class="btn btn-primary">New product</NavLink></p>


<div>
    <input type="text" @bind="searchTerm" placeholder="Search by title..." class="form-control" />
    <button class="btn btn-primary" @onclick="Search">Search</button>
</div>


@if (products == null)
{
    <p>@message</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Barcode</th>
                <th>Price</th>
                <th>ReleaseDate</th>
                <th>Options</th>
            </tr>
        </thead>
        <tbody>
            @if (!products.Any())
            {
                <tr><td colspan="6"><em>Brak produktów</em></td></tr>
            }
            @foreach (var product in products)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Title</td>
                    <td>@product.Barcode</td>
                    <td>@product.Price</td>
                    <td>@product.ReleaseDate.ToShortDateString()</td>
                    <td><button class="btn btn-primary" @onclick="() => EditProduct(product.Id)">Edit</button></td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-primary" @onclick="PreviousPage" disabled="@(currentPage == 1)">Poprzednia</button>
    <span style="margin: 0 10px">Strona @currentPage z @TotalPages</span>
    <button class="btn btn-primary" @onclick="NextPage" disabled="@(currentPage >= TotalPages)">Następna</button>
}

@code {

    List<Product>? products;
    string message = "Loading products...";
    string searchTerm = string.Empty;
    int totalCount;

    int currentPage = 1;
    const int pageSize = 10;

    // liczba wszystkich stron, minimum 1, żeby nie pokazywać "Strona 1 z 0" przy pustej liście
    int TotalPages => products == null || products.Count == 0
        ? 1
        : (int)Math.Ceiling(totalCount / (double)pageSize);



    void EditProduct(int productId)
    {
        // Navigate to the edit product page with the product ID
        NavigationManager.NavigateTo($"/products/editproduct/{productId}");
    }

    async Task NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
            await LoadProducts();
        }
    }

    async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadProducts();
        }
    }

    override protected async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    async Task Search()
    {
        await LoadProducts();
    }

    async Task LoadProducts()
    {
        try
        {
            var response = await ProductService.SearchProductsAsync(searchTerm,currentPage,pageSize);
            if (response.Success)
            {
                products = response.Data.Items;
                totalCount = response.Data.TotalCount;
            }else
            {
                products = new List<Product>();
                message = $"Error loading products: {response.Message}";
            }
        }
        catch (Exception ex)
        {
            message = $"Error loading products: {ex.Message}";
        }
    }
}