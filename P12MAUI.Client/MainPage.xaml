<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="P12MAUI.Client.MainPage"
             xmlns:viewmodel="clr-namespace:P12MAUI.Client.ViewModels"
             >

    <ScrollView>

        <VerticalStackLayout>
            <Button Text="Show map" Command="{Binding ShowMyLocationCommand}"></Button>
            <Label Text="{Binding ErrorMessage}"></Label>
            <Button Text="New product" Command="{Binding NewProductWindowCommand}"></Button>

            <HorizontalStackLayout Spacing="10">
                <Label Text="Category:" VerticalOptions="Center" />
                <Picker ItemsSource="{Binding FilterCategories}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedFilterCategory}"
                        WidthRequest="220" />
            </HorizontalStackLayout>

            <CollectionView ItemsSource="{Binding ProductItems}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Padding="10" Margin="0,5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ProductsViewModel}}, Path=ShowProductDetailsCommand }" 
                                    CommandParameter="{Binding Product}"
                                   />

                            </Border.GestureRecognizers>
                            
                            <VerticalStackLayout>
                                <Label Text="{Binding Product.Title}"></Label>
                                <Label Text="{Binding Product.Description}"></Label>
                                <Label Text="{Binding CategoryName}" FontAttributes="Italic"></Label>
                                <!--<Button Grid.Row="3"
Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ProductsViewModel}}, Path=ShowProductDetailsCommand }" 
CommandParameter="{Binding}"
Text="Edit"></Button>-->
                            </VerticalStackLayout>

                        </Border>
                        
                        
                  
                    
                    </DataTemplate>
                </CollectionView.ItemTemplate>


            </CollectionView>
        </VerticalStackLayout>
        


    </ScrollView>

</ContentPage>
